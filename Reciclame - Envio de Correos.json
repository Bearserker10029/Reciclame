{
  "name": "Reciclame - Envio de Correos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "rc-node-0001-webhook-0001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "reciclame-send-email"
    },
    {
      "parameters": {
        "fromEmail": "reciclame2@gmail.com",
        "toEmail": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "html",
        "message": "={{ $json.body.message }}",
        "options": {}
      },
      "id": "rc-node-0002-email-0002",
      "name": "Enviar Correo Gmail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [500, 300],
      "credentials": {
        "smtp": {
          "id": "gmail-smtp-reciclame",
          "name": "Gmail SMTP Reciclame"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Correo enviado correctamente\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "rc-node-0003-respond-0003",
      "name": "Responder Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Enviar Correo Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Correo Gmail": {
      "main": [
        [
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    { "name": "reciclame" },
    { "name": "email" }
  ]
}