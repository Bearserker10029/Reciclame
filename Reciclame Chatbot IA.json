      "parameters": {
        "jsCode": "const allowedTables = ['materials', 'recycling_centers', 'collection_points', 'schedule', 'instructions'];\nconst dangerousPatterns = /\\b(DROP|DELETE|UPDATE|INSERT|ALTER|TRUNCATE|CREATE|GRANT|REVOKE|EXEC|EXECUTE|UNION|INTO|OUTFILE|DUMPFILE)\\b/i;\nconst body = $input.first().json.body;\nconst query = body.query || body.message || '';\nif (dangerousPatterns.test(query)) {\n  throw new Error('Consulta no permitida: solo se permiten consultas SELECT');\n}\nconst selectMatch = query.match(/\\bSELECT\\b/i);\nif (!selectMatch) {\n  throw new Error('Solo se permiten consultas SELECT');\n}\nconst tableMatch = query.match(/FROM\\s+`?(\\w+)`?/i);\nif (tableMatch && !allowedTables.includes(tableMatch[1].toLowerCase())) {\n  throw new Error('Tabla no permitida: ' + tableMatch[1]);\n}\nreturn [{ json: { safeQuery: query, validated: true } }];"
      },
