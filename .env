# ─── Perfil Spring ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=aws

# ─── Base de datos RDS (MySQL en Amazon) ─────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://reciclame-db.cfowgekco09o.us-east-1.rds.amazonaws.com:3306/reciclame_db?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=Reciclame123

# ─── MinIO ────────────────────────────────────────────────────
MINIO_URL=http://reciclame-minio.duckdns.org
MINIO_INTERNAL_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reciclame-docs

# ─── MinIO (credenciales del servidor, no del cliente) ────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── KKFileView (visor de documentos) ─────────────────────────
KKFILEVIEW_URL=http://kkfileview:8012
KK_HTTP_PREVIEW=true
SPRING_FREEMARKER_TEMPLATE_LOADER_PATH=file:/opt/kkFileView/templates/web/,classpath:/web/

# ─── n8n (automatizaciones / chatbot / emails) ────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/send-email
N8N_CHATBOT_WEBHOOK_URL=/webhook/chatbot-reciclame
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Lima

# ─── App pública ─────────────────────────────────────────────
APP_BASE_URL=https://reciclame.duckdns.org
APP_KK_ACCESSIBLE_URL=http://reciclame-app1:8080

# ─── Redis (sesiones compartidas entre las 3 instancias) ─────
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# ─── Backups automáticos ─────────────────────────────────────
APP_BACKUP_PATH=/backups

# ─── Centrifugo (chat en tiempo real / WebSockets) ───────────
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=reciclame-api-key-local-2026
CENTRIFUGO_SECRET=reciclame-jwt-secret-local-2026-needs-at-least-32-bytes-long-ok
CENTRIFUGO_WS_URL=wss://reciclame.duckdns.org/connection/websocket
CENTRIFUGO_ALLOWED_ORIGINS=https://reciclame.duckdns.org

# ─── API Keys externas (RENIEC y SUNAT) ──────────────────────
